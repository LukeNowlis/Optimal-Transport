import gurobipy as gp
from gurobipy import GRB, quicksum
import numpy as np
import matplotlib.pyplot as plt
import time
import math
import json, os

#region INITALIZING NUMBERS
#===================
t_init_start = time.perf_counter()

NUMBER_OF_FLOORS=7
s=NUMBER_OF_FLOORS
NUMBER_OF_ELEVATORS=3
p=NUMBER_OF_ELEVATORS
CAPASITY_ELEVATOR=5

#Elevator times 
ACEL=0.9        #discount given to direct trips i.e. skipping floors is faster than stopping(just travel wise)
DISCOUNT=0.7    #discount given in general to elevator use vs. stairs (THis can be accounted for by changing stair costs)

row_vec = np.arange(s)[None, :] 
col_vec = np.arange(s)[:, None]
T_elevator = np.round((np.abs(col_vec - row_vec) ** ACEL)*DISCOUNT, 2)
print('ELEVATOR')
print(T_elevator) 

#dwell time(time taken while elevator is stopped at a floor)
DWELL_TIME=0.3

T_dwell=np.array([DWELL_TIME]*s)

#stairs times 
STAIR_ACEL = 0.99     # below 1 makes direct trips slightly cheaper; 1.0 means no preference
UP_COST = 7           # cost per floor going up
DOWN_COST = 4         #cost per floor going down  

fl = np.arange(s)
diff = fl[None, :] - fl[:, None]   # diff[i,j] = j - i
T_stairs = np.where(diff > 0, UP_COST * np.abs(diff) ** STAIR_ACEL,
            np.where(diff < 0, DOWN_COST * np.abs(diff) ** STAIR_ACEL, 0))
print('STAIRS')
print(np.round(T_stairs, 3))

#supply matrix
RANGE=10 #number of people who could be assigned any one floor and destination
print('Supply')
rng = np.random.default_rng(10)            
E = rng.integers(0, RANGE, size=(s, s))    
np.fill_diagonal(E, 0)     
total_people = int(E.sum()) #total_people in the system 
max_people_one_floor = int(E.sum(axis=1).max()) #most people entering at a floor 
print(E)

people_with_d = E.sum(axis=0)

print("People with destination d:")
print(people_with_d)

m=total_people #BIG m, used as an upper bound, can use some tightening later potentialy 
#endregion 

# region INDEXING
#================
#GETTING NUMS FOR EACH VARIABLE 
#how many pairs of floor to floor options there are given a destination, meaning i =! d and j=! i  
i_j_pairs_given_d = (s - 1)**2
v_num=p*s
h_num=(s*(s-1))//2
f_alpha_num=s*(s-1)*p
f_beta_num = s*s*p
f_lambda_num=s*p*i_j_pairs_given_d
f_eta_num=s*i_j_pairs_given_d
f_omega_num=s*(s-1)
n_num=p
n_max =math.ceil(E[0].sum() / CAPASITY_ELEVATOR) # True bound but much bigger(total_people - people_with_d[0])
N = n_max + 1
w_num = p * N * h_num #Only correct since h_num hasn't been mutiplied by p yet 

# h_pair_lookup: maps (T, count) finds all possible Top floor and count combinations, useful for constraints and used later on 
h_pair_lookup = {}
h_idx = 0
for T in range(1, s):           # top floor, 1 to s-1
    for count in range(2, T + 2):   # count ranges from 2 to T+1 inclusive
        h_pair_lookup[(T, count)] = h_idx
        h_idx += 1
h_num = p * h_idx   # h_idx now equals (s-1)*s/2 exactly, times p elevators

idx = {}
col = 0

idx['f_omega']  = (col, col + f_omega_num);  col += f_omega_num
idx['f_alpha']  = (col, col + f_alpha_num);  col += f_alpha_num
idx['f_beta']   = (col, col + f_beta_num);   col += f_beta_num
idx['f_lambda'] = (col, col + f_lambda_num); col += f_lambda_num
idx['f_eta']    = (col, col + f_eta_num);    col += f_eta_num

idx['v']        = (col, col + v_num);        col += v_num
idx['h']        = (col, col + h_num);        col += h_num
idx['w']        = (col, col + w_num);        col += w_num

idx['n']        = (col, col + n_num);        col += n_num

total_vars = col

alpha_pair_lookup = {}
for d in range(s):
    idx_i = 0
    for i in range(s):
        if i == d:
            continue
        alpha_pair_lookup[(d, i)] = idx_i
        idx_i += 1

def col_f_alpha(i, e, d):
    return idx['f_alpha'][0] + d*(s-1)*p + alpha_pair_lookup[(d, i)]*p + e

def col_f_beta(j, e, d):
    return idx['f_beta'][0] + d*s*p + j*p + e

def col_f_lambda(d, e, pair_idx):
    return idx['f_lambda'][0] + d * p * i_j_pairs_given_d + e * i_j_pairs_given_d + pair_idx

def col_f_eta(d, pair_idx):
    return idx['f_eta'][0] + d * i_j_pairs_given_d + pair_idx

def col_f_omega(i, d):
    return idx['f_omega'][0] + d*(s-1) + alpha_pair_lookup[(d, i)]

def col_v(e, i):
    return idx['v'][0] + e * s + i

def col_h(e, T, count):
    return idx['h'][0] + e * (h_idx) + h_pair_lookup[(T, count)]

def col_n(e):
    return idx['n'][0]+e

#Pair lookup, indexes each valid i,j pair given a destination d 
pair_lookup = {}
for d in range(s):
    pair_idx = 0
    for i in range(s):
        if i == d:
            continue
        for j in range(s):
            if j == i:
                continue
            pair_lookup[(d, i, j)] = pair_idx
            pair_idx += 1

# endregion 

#region HEADWAY- Travel time options
#WHEN I USE THE WORD HEADWAY IT IS A MISUSE OF THE WORD, I REALLY MEAN TRAVEL TIME ROUND TRIP  

#computes headway based on Top floor and count of floors stoped at (uses inputs from the first section)
def compute_headway(T, count):
    if count <= 1:
        return 0.0
    hop = T / (count - 1)
    travel_one_way = (count - 1) * DISCOUNT * (hop ** ACEL)
    stop_events = 2 * count - 2
    dwell_total = stop_events * DWELL_TIME
    return round(2 * travel_one_way + dwell_total, 2)

#uses h_pair_lookup from earlier to create a dictionary of all possible headways given every T and count 
headway_lookup = {
    (T, count): compute_headway(T, count)
    for (T, count) in h_pair_lookup
}

#find the correct headway too use in headway_lookup by using the correct index 
def get_elevator_headway(x_opt, e):
    for (T, count) in h_pair_lookup:
        if x_opt[col_h(e, T, count)] > 0.5:
            return headway_lookup[(T, count)], T, count
    return None, None, None   # should not happen if "exactly one h" constraint holds
#endregion

#region W LINEARIZING n*h
#create W variable which multiplies n and h we do this to simplify things for the solver 

def col_w(e, n_int, T, count):
    return idx['w'][0] + e*N*h_idx + n_int*h_idx + h_pair_lookup[(T, count)]

WAIT_FACTOR = 0.5   # average wait is half a loop; set to 1.0 to go back to worst case this is to adjust for h 

W_lookup = {}
for nu in range(n_max + 1):
    for (T, count), hd in headway_lookup.items():
        W_lookup[(nu, T, count)] = nu * WAIT_FACTOR * hd
#endregion

#region OPTIMIZATION INITALIZATION 
#=================================
BOUND=max_people_one_floor*0.9 #bound not perfect but gets most senarios 

cont = sum([f_alpha_num, f_beta_num, f_lambda_num, f_omega_num, f_eta_num])
bi= sum([v_num,h_num])

model = gp.Model()
model.Params.MIPGap = 0.075 #Error we stop at when finding the optimal solution 

binary_blocks = {'v', 'h', 'w'}
vars_list = [None] * total_vars

integer_blocks = {'n'}

#Establish variables, type and bounds 
for name, (start, end) in idx.items():
    for c in range(start, end):
        if name in binary_blocks:
            vars_list[c] = model.addVar(name=f"{name}_{c}", vtype="B")
        elif name in integer_blocks:
            vars_list[c] = model.addVar(name=f"{name}_{c}", vtype="I", lb=0, ub=n_max)
        else:
            vars_list[c] = model.addVar(name=f"{name}_{c}", vtype="C", lb=0, ub=BOUND)

#Potentially tightens bounds in this section 
def cap(d):
    # largest any single flow heading to destination d can be
    return float(min(BOUND, people_with_d[d]))

for d in range(s):
    for e in range(p):
        for i in range(s):
            if i != d:
                vars_list[col_f_alpha(i, e, d)].UB = cap(d)
        for j in range(s):
            vars_list[col_f_beta(j, e, d)].UB = cap(d)

for (d, i, j), pidx in pair_lookup.items():
    vars_list[col_f_eta(d, pidx)].UB = cap(d)
    for e in range(p):
        vars_list[col_f_lambda(d, e, pidx)].UB = cap(d)
#endregion

#region ADDING CONSTRIANTS
#==========================

#EQ 1 and 2 
#Constaint on f_lambda, to take people from i to j elevator must stop at both floors 
for e in range(p):
    for (d, i, j), pair_idx in pair_lookup.items():
        MD=min(BOUND,people_with_d[d]) # f_lamda cannot be bigger than people_with_d[d] so this bound is fine. If there is a problem with BOUND then we will get ther error at the end anyway so it's okay to take the min here 
        f = vars_list[col_f_lambda(d, e, pair_idx)]
        model.addConstr(f <= MD * vars_list[col_v(e, i)])    # must stop at origin
        model.addConstr(f <=MD * vars_list[col_v(e, j)])    # must stop at destination

#EQ 3 
#Constraint on f_lambda, to take people from i to k elevator cant stop on any j floors 
for e in range(p):
    for (i, k) in {(i, k) for (d, i, k) in pair_lookup}:
        lo, hi = min(i, k), max(i, k)
        for j in range(lo + 1, hi):
            expr = m * vars_list[col_v(e, j)]
            any_term = False
            for d in range(s):
                if (d, i, k) not in pair_lookup:
                    continue
                expr += vars_list[col_f_lambda(d, e, pair_lookup[(d, i, k)])]
                any_term = True
            if not any_term:
                continue
            MD=min(BOUND,people_with_d[d])
            model.addConstr(expr <= m)

# EQ 4 
# entry flow (f_omega) from o toward destination d must equal demand E[o][d]
for o in range(s):
    for d in range(s):
        if d == o:
            continue
        model.addConstr(vars_list[col_f_omega(o,d)]==E[o][d])

#EQ 5
#people exiting the elevator at their destination + people taking the stairs to their destination must equal total people with this floor as their destination
for d in range(s):
    exit_sum=0
    stair_sum=0
    for e in range(p):
        exit_sum+=vars_list[col_f_beta(d,e,d)]
    for i in range(s):
        if i == d:
            continue
        if (d, i, d) in pair_lookup:
            stair_sum+=vars_list[col_f_eta(d, pair_lookup[(d, i, d)])]
    E_sum = quicksum(E[o][d] for o in range(s) if o != d)
    model.addConstr(exit_sum+stair_sum == E_sum)

# EQ 6: 
# f_lambda(in) + f_alpha(j) = f_lambda(out) + f_beta(j)
for d in range(s):
    for j in range(s):
        for e in range(p):
            left = 0
            right = 0

            # riders arriving at j on the elevator (from any previous stop i)
            for i in range(s):
                if i != j and (d, i, j) in pair_lookup:
                    left += vars_list[col_f_lambda(d, e, pair_lookup[(d, i, j)])]

            # riders boarding at j (nobody boards at their own destination)
            if j != d:
                left += vars_list[col_f_alpha(j, e, d)]

            # riders continuing to the next stop k
            for k in range(s):
                if k != j and (d, j, k) in pair_lookup:
                    right += vars_list[col_f_lambda(d, e, pair_lookup[(d, j, k)])]

            # riders getting off at j (includes j == d, the final exit)
            right += vars_list[col_f_beta(j, e, d)]

            model.addConstr(left == right)

#EQ 7:
#people coming into a floor have to equal people coming out of a floor(for non destination floors)
for d in range(s):
    for j in range(s):
        if j == d:
            continue          # people leave the system at their destination

        in_sum = vars_list[col_f_omega(j, d)]   # people who start at j heading to d
        out_sum = 0

        for i in range(s):
            #IN FLOWS 
            if i != j and (d, i, j) in pair_lookup:
                pidx = pair_lookup[(d, i, j)]
                in_sum += vars_list[col_f_eta(d, pidx)]
                for e in range(p):
                    in_sum += vars_list[col_f_lambda(d, e, pidx)]

            #OUT FLOWS
            if i != j and (d, j, i) in pair_lookup:
                pidx = pair_lookup[(d, j, i)]
                out_sum += vars_list[col_f_eta(d, pidx)]
                for e in range(p):
                    out_sum += vars_list[col_f_lambda(d, e, pidx)]

        model.addConstr(in_sum == out_sum)

#H equations(8,9,10)
# EQ 8
# H has to match the top floor that an elevator stops on 
for e in range(p):
    for (T, count), _ in h_pair_lookup.items():
        # h(e,T,count) <= v(e,T)
        model.addConstr(vars_list[col_h(e, T, count)] <= vars_list[col_v(e, T)])

        # h(e,T,count) + sum_{j>T} v(e,j) <= 1   (aggregate the "no stops above T" rows)
        above = quicksum(vars_list[col_v(e, j)] for j in range(T + 1, s))
        model.addConstr(vars_list[col_h(e, T, count)] + above <= 1)

# EQ 9
#count must match number of stops
for e in range(p):
    model.addConstr(
        quicksum(vars_list[col_v(e, i)] for i in range(s))
        == quicksum(count * vars_list[col_h(e, T, count)] for (T, count) in h_pair_lookup)
    )

#EQ 10
# exactly one (T, count) is active per period
for e in range(p):
    model.addConstr(quicksum(vars_list[col_h(e, T, c)] for (T, c) in h_pair_lookup) == 1)

# EQ 11
# lobby: every elevator must stop at floor 0
for e in range(p):
    model.addConstr(vars_list[col_v(e, 0)]==1)

# EQ 12
# F_alpha/k <= n(e) < (F_alpha/k) + 1   (so n = ceil(F_alpha / k))
for e in range(p):
    total = quicksum(vars_list[col_f_alpha(0, e, d)] for d in range(1, s))
    n = total / CAPASITY_ELEVATOR
    model.addConstr(vars_list[col_n(e)] >= n)
    model.addConstr(vars_list[col_n(e)] <= n + 1- 1e-4)

# EQ 13 and 14 
# For each elevator and route (T, count): the W's across all n values sum to that route's h.
# h is 1 for exactly one route (EQ 10), so exactly one W per elevator is on, and it belongs to the active route.
for e in range(p):
    for (T, count) in h_pair_lookup:
        model.addConstr(
            quicksum(vars_list[col_w(e, nu, T, count)] for nu in range(N))
            == vars_list[col_h(e, T, count)]
        )

#EQ16
# The n of the active W must equal the n variable.
for e in range(p):
    model.addConstr(
        vars_list[col_n(e)]
        == quicksum(nu * vars_list[col_w(e, nu, T, count)]
                    for nu in range(N)
                    for (T, count) in h_pair_lookup)
    )

#EQ 17 
#Don't recheck elevator options that have already been checked since elevators are identical
# look at this more  
route_key = {(T, c): T * (s + 1) + c for (T, c) in h_pair_lookup}
for e in range(p - 1):
    model.addConstr(
        quicksum(route_key[r] * vars_list[col_h(e, *r)] for r in h_pair_lookup)
        >= quicksum(route_key[r] * vars_list[col_h(e + 1, *r)] for r in h_pair_lookup)
    )

#EQ 18
#constraints on f_alpha and Beta to speed up solver 
for e in range(p):
    for d in range(s):
        for j in range(s):
            if j != d:
                model.addConstr(vars_list[col_f_alpha(j, e, d)] <= cap(d) * vars_list[col_v(e, j)])
            model.addConstr(vars_list[col_f_beta(j, e, d)] <= cap(d) * vars_list[col_v(e, j)])



#endregion

#region Objective function
#===================
c_obj = np.zeros(total_vars)

#STAIRS COSTS
for d in range(s):
    for i in range(s):
        if i == d:
            continue
        for j in range(s):
            if j == i:
                continue
            c_obj[col_f_eta(d, pair_lookup[(d, i, j)])] += T_stairs[i][j]

#ELEVATOR COSTS 
def C_lambda(i,j):
    #IF you want to add diffrent travel times and dwell times depending on the elevator this must be changed
    return T_elevator[i, j] + T_dwell[i] / 2 + T_dwell[j] / 2

for d in range(s):
    for i in range(s):
        if i == d:
            continue
        for j in range(s):
            if j == i:
                continue
            for e in range(p):
                c_obj[col_f_lambda(d, e, pair_lookup[(d, i, j)])] += C_lambda(i, j)

#WAITING COST
MID_CONSTANT = 0.55 # a constant close to 1/2 for mid floors equation 

def H_expr(e):
    return WAIT_FACTOR * quicksum(headway_lookup[(T, count)] * vars_list[col_h(e, T, count)]
                                  for (T, count) in h_pair_lookup)                 
def F_alpha_cost(i, e, direction):
    dests = range(i + 1, s) if direction == 'up' else range(0, i)
    return quicksum(vars_list[col_f_alpha(i, e, d)] for d in dests)

def F_lambda_cost(i, e, direction):
    targets = range(i + 1, s) if direction == 'up' else range(0, i)
    return quicksum(
        vars_list[col_f_lambda(d, e, pair_lookup[(d, i, j)])]
        for d in range(s) if d != i
        for j in targets)

def W_expr(e):
    return quicksum(W_lookup[(nu, T, count)] * vars_list[col_w(e, nu, T, count)]
                    for (nu, T, count) in W_lookup)
#Mid floors function
def G(i,e,direction):
    H=H_expr(e)
    N=F_lambda_cost(i,e,direction)/CAPASITY_ELEVATOR
    return(N+1)*H*F_alpha_cost(i,e,direction)*MID_CONSTANT

K = CAPASITY_ELEVATOR

#BOTTUM FLOOR 
base_sum = 0
for e in range(p):
    n = vars_list[col_n(e)]
    H = H_expr(e)
    W = W_expr(e)
    base_sum += K * W * (n - 1) / 2 # sum from 0 to n-1
    base_sum += (F_alpha_cost(0, e, 'up') - (n - 1) * K) * W

# Mid floors, added U constrint to turn this equation into a quadratic as well 
mid_sum = 0
for e in range(p):
    floors = ([(i, 'up') for i in range(1, s - 1)] +
              [(i, 'down') for i in range(1, s - 1)] +
              [(s - 1, 'down')])
    for i, direction in floors:
        Fa = F_alpha_cost(i, e, direction)
        Fl = F_lambda_cost(i, e, direction)

        # one copy of Fa per route
        dests = range(i + 1, s) if direction == 'up' else range(0, i)
        Mu = sum(cap(d) for d in dests)
        u = {c: model.addVar(lb=0, ub=Mu) for c in h_pair_lookup}
        for c in h_pair_lookup:
            model.addConstr(u[c] <= m * vars_list[col_h(e, *c)])   # off unless route c is active
        model.addConstr(quicksum(u.values()) == Fa)                   # copies add up to Fa

        # H*Fa, linear (WAIT_FACTOR applied, same as H_expr)
        HFa = quicksum(WAIT_FACTOR * headway_lookup[c] * u[c] for c in h_pair_lookup)

        mid_sum += MID_CONSTANT * (HFa + HFa * Fl / K)    # HFa*Fl is the one quadratic term

obj_expr = quicksum(c_obj[c] * vars_list[c] for c in range(total_vars) if c_obj[c] != 0) + base_sum + mid_sum

init_time = time.perf_counter() - t_init_start
print(f"Initalizing took {init_time:.2f} seconds") 
#endregion

#region SOLVING AND OUTPUT 
#==========================
t_opt_start = time.perf_counter() 
t = model.addVar(name="t", vtype=GRB.CONTINUOUS, lb=-GRB.INFINITY)
model.addConstr(t >= obj_expr)
model.Params.OutputFlag = 0
model.Params.NonConvex = 2 
model.setObjective(t, GRB.MINIMIZE)
model.optimize()

opt_time = time.perf_counter() - t_opt_start

status = {GRB.OPTIMAL: "optimal",
          GRB.INFEASIBLE: "infeasible",
          GRB.INF_OR_UNBD: "infeasible_or_unbounded",
          GRB.UNBOUNDED: "unbounded",
          GRB.TIME_LIMIT: "time_limit"}.get(model.Status, str(model.Status))
print(status)
print(f"Optimization took {opt_time:.2f} seconds")

if model.Status == GRB.OPTIMAL:
    TOL = 1e-6
    
    # 1. Continuous variables that hit the BOUND
    # (Storing the name and value so you can see exactly which one it is)
    hit_flow = [(v.VarName, v.X) for v in model.getVars()
                if v.VType == GRB.CONTINUOUS
                and abs(v.UB - BOUND) < 1e-9
                and v.X >= v.UB - TOL]
    
    # 2. Integer variable n at its ceiling
    hit_n = [(vars_list[col_n(e)].VarName, vars_list[col_n(e)].X) for e in range(p)
             if vars_list[col_n(e)].X >= n_max - TOL]

    # 3. Lobby boarding at its cap
    hit_lobby = [e for e in range(p)
                 if sum(vars_list[col_f_alpha(0, e, d)].X for d in range(1, s))
                    >= n_max * CAPASITY_ELEVATOR - TOL]

    # Changed from raising an error to printing a warning
    if hit_flow or hit_lobby or hit_n:
        print("\n" + "="*50)
        print("WARNING: The true optimum may be blocked!")
        print("You may need to raise BOUND or n_max and re-run.")
        
        if hit_flow:
            print(f"\nContinuous variables at BOUND ({BOUND}):")
            for name, val in hit_flow:
                print(f"  - {name} = {val:.4f}")
                
        if hit_n:
            print(f"\nInteger variables n at n_max ({n_max}):")
            for name, val in hit_n:
                print(f"  - {name} = {val}")
                
        if hit_lobby:
            print(f"\nLobby boarding on elevators {hit_lobby} is at the cap:")
            print(f"  (Capacity = {n_max * CAPASITY_ELEVATOR})")
        print("="*50 + "\n")
    
    x_opt = np.array([v.X for v in vars_list])

    # print("\n=== W check ===")
    # for e in range(p):
    #     n_val = x_opt[col_n(e)]

    #     # h dot headway_lookup (WAIT_FACTOR not applied, raw headway)
    #     H_dot = sum(headway_lookup[(T, count)] * x_opt[col_h(e, T, count)]
    #                 for (T, count) in h_pair_lookup)

